#!/usr/bin/env bash
set -uo pipefail

repo_root="$(git rev-parse --show-toplevel 2>/dev/null)" || exit 0
[ -f "$repo_root/VRCFaceTracking.sln" ] || exit 0

if ! command -v dotnet >/dev/null 2>&1; then
  echo "pre-push: dotnet not found; skipping format check." >&2
  exit 0
fi

upstream="$(git rev-parse --abbrev-ref --symbolic-full-name '@{u}' 2>/dev/null || true)"
[ -n "$upstream" ] || upstream="origin/main"
if ! git rev-parse --verify -q "$upstream" >/dev/null; then
  upstream="HEAD~1"
fi

changed="$(git diff --name-only --diff-filter=ACMR "$upstream...HEAD" -- '*.cs' 2>/dev/null | head -1)"
if [ -z "$changed" ]; then
  echo "pre-push: no C# changes since $upstream; skipping format check." >&2
  exit 0
fi

echo "pre-push: checking formatting (dotnet format --verify-no-changes)..." >&2
(cd "$repo_root" && dotnet format VRCFaceTracking.sln --verify-no-changes --no-restore -v q)
if [ "$?" -ne 0 ]; then
  {
    echo ""
    echo "pre-push BLOCKED: the solution would fail CI's lint job."
    echo "  Fix format:  dotnet format VRCFaceTracking.sln"
    echo "  Bypass:      git push --no-verify"
    echo ""
  } >&2
  exit 1
fi
exit 0
