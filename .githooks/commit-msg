#!/usr/bin/env bash

set -euo pipefail

msg_file="$1"
[ -f "$msg_file" ] || exit 0

subject="$(grep -m1 -vE '^(#|$)' "$msg_file" || true)"
[ -n "$subject" ] || exit 0

count=$( ( printf '%s\n' "$subject" | grep -oE '\([0-9]{4}\.[0-9]+\.[0-9]+\.[0-9]+(-[A-Fa-f0-9]{4})?\)' || true ) \
  | grep -c . \
  || true )
count=${count//[^0-9]/}
[ -n "$count" ] || count=0

if [ "${count:-0}" -gt 1 ]; then
  echo "" >&2
  echo "commit-msg: subject contains $count build-version stamps; expected at most one." >&2
  echo "" >&2
  echo "  subject: $subject" >&2
  echo "" >&2
  echo "Editor templates sometimes autocomplete a stale (YYYY.M.D.N-XXXX) tag from the previous" >&2
  echo "commit. Edit the subject so only the current build's tag remains, then commit again." >&2
  echo "" >&2
  exit 1
fi

case "$subject" in
  Merge\ *|Revert\ *|fixup!\ *|squash!\ *) exit 0 ;;
esac

if ! printf '%s\n' "$subject" | grep -qE '^(feat|fix|chore|ci|docs|refactor|test|perf|diag|style)(\([a-z0-9-]+\))?!?: .+'; then
  echo "" >&2
  echo "commit-msg: subject is not a conventional commit." >&2
  echo "" >&2
  echo "  subject: $subject" >&2
  echo "" >&2
  echo "Use <type>(<scope>): <summary> with type feat, fix, chore, ci, docs, refactor, test, perf, diag or style." >&2
  echo "Release notes are built from these subjects." >&2
  echo "" >&2
  exit 1
fi

exit 0
