<UserControl
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ui="using:FluentAvalonia.UI.Controls"
    xmlns:s="using:VRCFaceTracking.Strings"
    xmlns:vm="using:VRCFaceTracking.ViewModels"
    x:DataType="vm:SettingsViewModel"
    x:Class="VRCFaceTracking.Views.SettingsPage">

    <UserControl.DataTemplates>
        <DataTemplate x:DataType="vm:OscFieldViewModel">
            <StackPanel Classes="tracking-controls">
                <TextBlock Classes="field-error"
                           Text="{Binding Error}"
                           IsVisible="{Binding HasError}" />
                <TextBox Classes="tracking-text settings-field"
                         Classes.invalid="{Binding HasError}"
                         MaxLength="5"
                         Text="{Binding Text, Mode=TwoWay, UpdateSourceTrigger=LostFocus}"
                         KeyDown="Field_KeyDown" />
            </StackPanel>
        </DataTemplate>
    </UserControl.DataTemplates>

    <ScrollViewer>
        <StackPanel Classes="page-stack">
            <TextBlock Classes="page-title" Text="{x:Static s:Resources.Settings_Title}" />

            <Border Classes="card tracking-card">
                <StackPanel>
                    <Grid Classes="tracking-card-header" ColumnDefinitions="*">
                        <StackPanel Classes="tracking-label">
                            <TextBlock Classes="tracking-card-title" Text="{x:Static s:Resources.Appearance_Text}" />
                        </StackPanel>
                    </Grid>
                    <Border Classes="tracking-divider" />
                    <Grid Classes="tracking-row" ColumnDefinitions="*,Auto">
                        <StackPanel Grid.Column="0" Classes="tracking-label">
                            <TextBlock Classes="tracking-row-label" Text="{x:Static s:Resources.ThemeSettings_Header}" />
                        </StackPanel>
                        <ComboBox Grid.Column="1" x:Name="ThemeCombo" Classes="settings-field"
                                  SelectionChanged="ThemeCombo_SelectionChanged"
                                  AutomationProperties.Name="{x:Static s:Resources.ThemeSettings_Header}">
                            <ComboBoxItem Content="{x:Static s:Resources.Settings_Theme_Light_Content}" Tag="Light" />
                            <ComboBoxItem Content="{x:Static s:Resources.Settings_Theme_Dark_Content}" Tag="Dark" />
                            <ComboBoxItem Content="{x:Static s:Resources.Settings_Theme_Default_Content}" Tag="Default" />
                        </ComboBox>
                    </Grid>
                </StackPanel>
            </Border>

            <Border Classes="card tracking-card">
                <StackPanel>
                    <Grid Classes="tracking-card-header" ColumnDefinitions="*">
                        <StackPanel Classes="tracking-label">
                            <TextBlock Classes="tracking-card-title" Text="{x:Static s:Resources.Settings_Connection_Title}" />
                            <TextBlock Classes="tracking-card-description" Text="{x:Static s:Resources.Settings_Connection_Description}" />
                        </StackPanel>
                    </Grid>
                    <Border Classes="tracking-divider" />
                    <Grid Classes="tracking-row" ColumnDefinitions="*,Auto">
                        <TextBlock Grid.Column="0" Classes="tracking-row-label" Text="{x:Static s:Resources.OscAddressLabel}" />
                        <StackPanel Grid.Column="1" Classes="tracking-controls">
                            <TextBlock Classes="field-error"
                                       Text="{Binding AddressField.Error}"
                                       IsVisible="{Binding AddressField.HasError}" />
                            <TextBox Classes="tracking-text settings-field wide"
                                     Classes.invalid="{Binding AddressField.HasError}"
                                     Watermark="127.0.0.1"
                                     ToolTip.Tip="{x:Static s:Resources.OscAddressTooltip}"
                                     Text="{Binding AddressField.Text, Mode=TwoWay, UpdateSourceTrigger=LostFocus}"
                                     AutomationProperties.Name="{x:Static s:Resources.OscAddressLabel}"
                                     KeyDown="Field_KeyDown" />
                        </StackPanel>
                    </Grid>
                    <Grid Classes="tracking-row" ColumnDefinitions="*,Auto">
                        <TextBlock Grid.Column="0" Classes="tracking-row-label" Text="{x:Static s:Resources.OscInPortLabel}"
                                   ToolTip.Tip="{x:Static s:Resources.OscInPortTooltip}" />
                        <StackPanel Grid.Column="1" Classes="tracking-controls">
                            <TextBlock Classes="field-error"
                                       Text="{Binding InPortField.Error}"
                                       IsVisible="{Binding InPortField.HasError}" />
                            <TextBox Classes="tracking-text settings-field"
                                     Classes.invalid="{Binding InPortField.HasError}"
                                     MaxLength="5"
                                     ToolTip.Tip="{x:Static s:Resources.OscInPortTooltip}"
                                     Text="{Binding InPortField.Text, Mode=TwoWay, UpdateSourceTrigger=LostFocus}"
                                     AutomationProperties.Name="{x:Static s:Resources.OscInPortLabel}"
                                     KeyDown="Field_KeyDown" />
                        </StackPanel>
                    </Grid>
                    <Grid Classes="tracking-row" ColumnDefinitions="*,Auto">
                        <TextBlock Grid.Column="0" Classes="tracking-row-label" Text="{x:Static s:Resources.OscOutPortLabel}"
                                   ToolTip.Tip="{x:Static s:Resources.OscOutPortTooltip}" />
                        <StackPanel Grid.Column="1" Classes="tracking-controls">
                            <TextBlock Classes="field-error"
                                       Text="{Binding OutPortField.Error}"
                                       IsVisible="{Binding OutPortField.HasError}" />
                            <TextBox Classes="tracking-text settings-field"
                                     Classes.invalid="{Binding OutPortField.HasError}"
                                     MaxLength="5"
                                     ToolTip.Tip="{x:Static s:Resources.OscOutPortTooltip}"
                                     Text="{Binding OutPortField.Text, Mode=TwoWay, UpdateSourceTrigger=LostFocus}"
                                     AutomationProperties.Name="{x:Static s:Resources.OscOutPortLabel}"
                                     KeyDown="Field_KeyDown" />
                        </StackPanel>
                    </Grid>
                </StackPanel>
            </Border>

            <Border Classes="card tracking-card" IsVisible="{Binding IsStartupVisible}">
                <StackPanel>
                    <Grid Classes="tracking-card-header" ColumnDefinitions="*">
                        <StackPanel Classes="tracking-label">
                            <TextBlock Classes="tracking-card-title" Text="{x:Static s:Resources.Settings_Startup_Title}" />
                        </StackPanel>
                    </Grid>
                    <Border Classes="tracking-divider" />
                    <Grid Classes="tracking-row" ColumnDefinitions="*,Auto" IsVisible="{Binding IsOpenVRSupported}"
                          ToolTip.Tip="{x:Static s:Resources.AutoStartSettingsTooltip}">
                        <StackPanel Grid.Column="0" Classes="tracking-label">
                            <TextBlock Classes="tracking-row-label" Text="{x:Static s:Resources.AutoStartSettings_Header}" />
                            <TextBlock Classes="tracking-row-state" Text="{Binding AutoStartDescription}" />
                        </StackPanel>
                        <ToggleSwitch Grid.Column="1" Classes="tracking-switch"
                                      IsChecked="{Binding AutoStart, Mode=TwoWay}"
                                      IsEnabled="{Binding IsOpenVREnabled}"
                                      AutomationProperties.Name="{x:Static s:Resources.AutoStartSettings_Header}" />
                    </Grid>
                    <Grid Classes="tracking-row" ColumnDefinitions="*,Auto" IsVisible="{Binding IsOpenVRSupported}">
                        <StackPanel Grid.Column="0" Classes="tracking-label">
                            <TextBlock Classes="tracking-row-label" Text="{x:Static s:Resources.ExitWithSteamVrHeader}" />
                            <TextBlock Classes="tracking-row-state" Text="{x:Static s:Resources.ExitWithSteamVrDescription}" />
                        </StackPanel>
                        <ToggleSwitch Grid.Column="1" Classes="tracking-switch"
                                      IsChecked="{Binding ExitWithSteamVr, Mode=TwoWay}"
                                      AutomationProperties.Name="{x:Static s:Resources.ExitWithSteamVrHeader}" />
                    </Grid>
                    <Grid Classes="tracking-row" ColumnDefinitions="*,Auto" IsVisible="{Binding IsUpdateCheckAvailable}">
                        <TextBlock Grid.Column="0" Classes="tracking-row-label" Text="{x:Static s:Resources.UpdatesHeader}" />
                        <ToggleSwitch Grid.Column="1" Classes="tracking-switch"
                                      IsChecked="{Binding CheckUpdatesOnStartup, Mode=TwoWay}"
                                      AutomationProperties.Name="{x:Static s:Resources.UpdatesHeader}" />
                    </Grid>
                    <Grid Classes="tracking-row" ColumnDefinitions="*,Auto" IsVisible="{Binding IsUpdateCheckAvailable}">
                        <TextBlock Grid.Column="0" Classes="tracking-row-label" Text="{x:Static s:Resources.CheckUpdatesHeader}" />
                        <Button Grid.Column="1" Classes="tracking-action"
                                Content="{x:Static s:Resources.CheckUpdatesButtonContent}"
                                Command="{Binding CheckUpdatesCommand}"
                                ToolTip.Tip="{x:Static s:Resources.CheckUpdatesTooltip}" />
                    </Grid>
                </StackPanel>
            </Border>

            <Border Classes="card tracking-card">
                <StackPanel>
                    <Grid Classes="tracking-card-header" ColumnDefinitions="*,Auto">
                        <StackPanel Grid.Column="0" Classes="tracking-label">
                            <TextBlock Classes="tracking-card-title" Text="{x:Static s:Resources.DeveloperSectionHeader}" />
                            <TextBlock Classes="tracking-card-description" Text="{x:Static s:Resources.Settings_Developer_Description}" />
                        </StackPanel>
                        <ToggleSwitch Grid.Column="1" Classes="tracking-switch"
                                      IsChecked="{Binding Developer.Enabled, Mode=TwoWay}"
                                      AutomationProperties.Name="{x:Static s:Resources.DeveloperModeHeader}" />
                    </Grid>
                    <StackPanel IsVisible="{Binding Developer.Enabled}">
                        <Border Classes="tracking-divider" />
                        <TextBlock Classes="tracking-section-title settings-group" Text="{x:Static s:Resources.LoggingSectionHeader}" />
                        <Grid Classes="tracking-row" ColumnDefinitions="*,Auto" ToolTip.Tip="{x:Static s:Resources.VerboseLoggingTooltip}">
                            <StackPanel Grid.Column="0" Classes="tracking-label">
                                <TextBlock Classes="tracking-row-label" Text="{x:Static s:Resources.VerboseLoggingHeader}" />
                                <TextBlock Classes="tracking-row-state" Text="{Binding VerboseDescription}" />
                            </StackPanel>
                            <ToggleSwitch Grid.Column="1" Classes="tracking-switch"
                                          IsChecked="{Binding VerboseLogging, Mode=TwoWay}"
                                          IsEnabled="{Binding IsVerboseToggleEnabled}"
                                          AutomationProperties.Name="{x:Static s:Resources.VerboseLoggingHeader}" />
                        </Grid>
                        <Grid Classes="tracking-row" ColumnDefinitions="*,Auto">
                            <StackPanel Grid.Column="0" Classes="tracking-label">
                                <TextBlock Classes="tracking-row-label" Text="{x:Static s:Resources.ShapeLoggingHeader}" />
                            </StackPanel>
                            <ToggleSwitch Grid.Column="1" Classes="tracking-switch"
                                          IsChecked="{Binding ShapeLogging, Mode=TwoWay}"
                                          AutomationProperties.Name="{x:Static s:Resources.ShapeLoggingHeader}" />
                        </Grid>
                        <Grid Classes="tracking-row" ColumnDefinitions="*,Auto" ToolTip.Tip="{x:Static s:Resources.LogFilesToKeepTooltip}">
                            <StackPanel Grid.Column="0" Classes="tracking-label">
                                <TextBlock Classes="tracking-row-label" Text="{x:Static s:Resources.LogFilesToKeepHeader}" />
                            </StackPanel>
                            <NumericUpDown Grid.Column="1" Classes="settings-field"
                                           Minimum="1"
                                           Maximum="200"
                                           Increment="1"
                                           FormatString="0"
                                           VerticalAlignment="Center"
                                           Value="{Binding LogFilesToKeep, Mode=TwoWay}"
                                           AutomationProperties.Name="{x:Static s:Resources.LogFilesToKeepHeader}" />
                        </Grid>
                        <Grid Classes="tracking-row" ColumnDefinitions="*,Auto">
                            <StackPanel Grid.Column="0" Classes="tracking-label">
                                <TextBlock Classes="tracking-row-label" Text="{x:Static s:Resources.LogFolderHeader}" />
                                <TextBlock Classes="tracking-row-state path" Text="{Binding LogFolderDescription}" />
                            </StackPanel>
                            <StackPanel Grid.Column="1" Classes="tracking-controls">
                                <Button Classes="tracking-action"
                                        Content="{x:Static s:Resources.LogFolderChangeContent}"
                                        Click="ChangeLogFolder_Click"
                                        ToolTip.Tip="{x:Static s:Resources.LogFolderTooltip}" />
                                <Button Classes="tracking-action"
                                        Content="{x:Static s:Resources.LogFolderResetContent}"
                                        Command="{Binding ResetLogDirectoryCommand}"
                                        IsEnabled="{Binding HasCustomLogFolder}" />
                                <Button Classes="tracking-action"
                                        Content="{x:Static s:Resources.OpenLogsButtonContent}"
                                        Command="{Binding OpenLogsCommand}" />
                            </StackPanel>
                        </Grid>

                        <TextBlock Classes="tracking-section-title settings-group" Text="{x:Static s:Resources.Settings_Troubleshooting_Title}" />
                        <Grid Classes="tracking-row" ColumnDefinitions="*,Auto" ToolTip.Tip="{x:Static s:Resources.Settings_Troubleshooting_Tooltip}">
                            <StackPanel Grid.Column="0" Classes="tracking-label">
                                <TextBlock Classes="tracking-row-label" Text="{x:Static s:Resources.Settings_Troubleshooting_Enable}" />
                                <TextBlock Classes="tracking-row-state" Text="{x:Static s:Resources.Settings_Troubleshooting_EnableDescription}" />
                            </StackPanel>
                            <ToggleSwitch Grid.Column="1" Classes="tracking-switch"
                                          IsChecked="{Binding RiskySettings.Enabled, Mode=TwoWay}"
                                          AutomationProperties.Name="{x:Static s:Resources.Settings_Troubleshooting_Enable}" />
                        </Grid>
                        <Grid Classes="tracking-row indented" ColumnDefinitions="*,Auto"
                              IsEnabled="{Binding RiskySettings.Enabled}"
                              ToolTip.Tip="{x:Static s:Resources.ForceRelevancyTooltip}">
                            <StackPanel Grid.Column="0" Classes="tracking-label">
                                <TextBlock Classes="tracking-row-label" Text="{x:Static s:Resources.ForceRelevancyToggle_Header}" />
                            </StackPanel>
                            <ToggleSwitch Grid.Column="1" Classes="tracking-switch"
                                          IsChecked="{Binding RiskySettings.AllRelevantDebug, Mode=TwoWay}"
                                          AutomationProperties.Name="{x:Static s:Resources.ForceRelevancyToggle_Header}" />
                        </Grid>
                        <Grid Classes="tracking-row indented" ColumnDefinitions="*,Auto" IsEnabled="{Binding RiskySettings.Enabled}">
                            <StackPanel Grid.Column="0" Classes="tracking-label">
                                <TextBlock Classes="tracking-row-label" Text="{x:Static s:Resources.ForceReInitButton_Header}" />
                            </StackPanel>
                            <Button Grid.Column="1" Classes="tracking-action"
                                    Content="{x:Static s:Resources.ReInitButton_Content}"
                                    Click="ForceReInit_Click"
                                    AutomationProperties.Name="{x:Static s:Resources.ForceReInitButton_Header}" />
                        </Grid>
                        <Grid Classes="tracking-row indented" ColumnDefinitions="*,Auto" IsEnabled="{Binding RiskySettings.Enabled}">
                            <StackPanel Grid.Column="0" Classes="tracking-label">
                                <TextBlock Classes="tracking-row-label" Text="{x:Static s:Resources.ResetVRCFTButton_Header}" />
                            </StackPanel>
                            <Button Grid.Column="1" Classes="tracking-action"
                                    Content="{x:Static s:Resources.ResetButton_Content}"
                                    Click="ResetVRCFT_Click"
                                    AutomationProperties.Name="{x:Static s:Resources.ResetVRCFTButton_Header}" />
                        </Grid>
                        <Grid Classes="tracking-row indented" ColumnDefinitions="*,Auto" IsEnabled="{Binding RiskySettings.Enabled}">
                            <StackPanel Grid.Column="0" Classes="tracking-label">
                                <TextBlock Classes="tracking-row-label" Text="{x:Static s:Resources.ResetAvatarConfButton_Header}" />
                            </StackPanel>
                            <Button Grid.Column="1" Classes="tracking-action"
                                    Content="{x:Static s:Resources.ResetButton_Content}"
                                    Click="ResetAvatarConfig_Click"
                                    AutomationProperties.Name="{x:Static s:Resources.ResetAvatarConfButton_Header}" />
                        </Grid>
                    </StackPanel>
                </StackPanel>
            </Border>

            <Border Classes="card tracking-card">
                <StackPanel>
                    <Grid Classes="tracking-card-header" ColumnDefinitions="*">
                        <StackPanel Classes="tracking-label">
                            <TextBlock Classes="tracking-card-title" Text="{x:Static s:Resources.About_Text}" />
                            <TextBlock Classes="tracking-card-description" Text="{x:Static vm:SettingsViewModel.VersionText}" />
                        </StackPanel>
                    </Grid>
                    <Border Classes="tracking-divider" />
                    <Grid Classes="tracking-row" ColumnDefinitions="*,Auto">
                        <TextBlock Grid.Column="0" Classes="tracking-row-label" Text="{x:Static s:Resources.Settings_Link_Source}" />
                        <Button Grid.Column="1" Classes="tracking-action"
                                Content="{x:Static s:Resources.Settings_Link_Open}"
                                Tag="https://github.com/RealWhyKnot/VRCFaceTracking"
                                Click="Link_Click"
                                AutomationProperties.Name="{x:Static s:Resources.Settings_Link_Source}" />
                    </Grid>
                    <Grid Classes="tracking-row" ColumnDefinitions="*,Auto">
                        <TextBlock Grid.Column="0" Classes="tracking-row-label" Text="{x:Static s:Resources.Settings_Link_License}" />
                        <Button Grid.Column="1" Classes="tracking-action"
                                Content="{x:Static s:Resources.Settings_Link_Open}"
                                Tag="https://github.com/RealWhyKnot/VRCFaceTracking/blob/main/LICENSE"
                                Click="Link_Click"
                                AutomationProperties.Name="{x:Static s:Resources.Settings_Link_License}" />
                    </Grid>
                    <Grid Classes="tracking-row" ColumnDefinitions="*,Auto">
                        <TextBlock Grid.Column="0" Classes="tracking-row-label" Text="{x:Static s:Resources.Settings_Link_Privacy}" />
                        <Button Grid.Column="1" Classes="tracking-action"
                                Content="{x:Static s:Resources.Settings_Link_Open}"
                                Tag="https://github.com/RealWhyKnot/VRCFaceTracking/blob/main/PRIVACY.md"
                                Click="Link_Click"
                                AutomationProperties.Name="{x:Static s:Resources.Settings_Link_Privacy}" />
                    </Grid>
                    <ToggleButton x:Name="ContributorsToggle" Classes="tracking-more">
                        <StackPanel Classes="icon-label">
                            <TextBlock Text="{x:Static s:Resources.ContributorsHeader}" />
                            <ui:SymbolIcon Classes="chevron" Symbol="ChevronDown" IsVisible="{Binding !#ContributorsToggle.IsChecked}" />
                            <ui:SymbolIcon Classes="chevron" Symbol="ChevronUp" IsVisible="{Binding #ContributorsToggle.IsChecked}" />
                        </StackPanel>
                    </ToggleButton>
                    <StackPanel IsVisible="{Binding #ContributorsToggle.IsChecked}">
                        <TextBlock Classes="tracking-row-state" Text="{x:Static s:Resources.Credits_Description}" Margin="0,4,0,8" />
                        <ScrollViewer MaxHeight="240" VerticalScrollBarVisibility="Auto">
                            <ItemsControl ItemsSource="{Binding Contributors}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <WrapPanel ItemSpacing="8" LineSpacing="8" />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Button Tag="{Binding HtmlUrl}" Click="Link_Click" Content="{Binding Login}" />
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </StackPanel>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
