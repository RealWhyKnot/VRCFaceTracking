<UserControl
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ui="using:FluentAvalonia.UI.Controls"
    xmlns:s="using:VRCFaceTracking.Strings"
    xmlns:vm="using:VRCFaceTracking.ViewModels"
    xmlns:c="using:VRCFaceTracking.Controls"
    xmlns:h="using:VRCFaceTracking.Helpers"
    x:DataType="vm:MutatorViewModel"
    x:Class="VRCFaceTracking.Views.MutatorPage">

    <UserControl.DataTemplates>
        <DataTemplate x:DataType="vm:SettingSectionViewModel">
            <StackPanel Classes="tracking-section" IsVisible="{Binding IsVisible}">
                <TextBlock Classes="tracking-section-title" Text="{Binding Title}" IsVisible="{Binding ShowTitle}" />
                <ToggleButton Classes="tracking-section-toggle"
                              IsVisible="{Binding IsCollapsible}"
                              IsChecked="{Binding IsExpanded, Mode=TwoWay}"
                              AutomationProperties.Name="{Binding Title}">
                    <Grid ColumnDefinitions="*,Auto">
                        <TextBlock Grid.Column="0" Classes="tracking-section-label" Text="{Binding Title}" />
                        <ui:SymbolIcon Grid.Column="1" Classes="chevron" Symbol="ChevronDown" IsVisible="{Binding !IsExpanded}" />
                        <ui:SymbolIcon Grid.Column="1" Classes="chevron" Symbol="ChevronUp" IsVisible="{Binding IsExpanded}" />
                    </Grid>
                </ToggleButton>
                <ItemsControl ItemsSource="{Binding Rows}" IsVisible="{Binding ShowRows}" />
            </StackPanel>
        </DataTemplate>

        <DataTemplate x:DataType="vm:ToggleRowViewModel">
            <Grid Classes="tracking-row" Classes.indented="{Binding IsIndented}"
                  ColumnDefinitions="*,Auto"
                  IsVisible="{Binding IsVisible}"
                  IsEnabled="{Binding IsEnabled}"
                  ToolTip.Tip="{Binding Tip}">
                <StackPanel Grid.Column="0" Classes="tracking-label">
                    <TextBlock Classes="tracking-row-label" Text="{Binding Label}" />
                    <TextBlock Classes="tracking-row-state"
                               Classes.live="{Binding IsStateActive}"
                               Text="{Binding StateText}"
                               IsVisible="{Binding HasState}"
                               ToolTip.Tip="{Binding StateTip}" />
                </StackPanel>
                <ToggleSwitch Grid.Column="1"
                              Classes="tracking-switch"
                              IsChecked="{Binding IsChecked, Mode=TwoWay}"
                              AutomationProperties.Name="{Binding Label}" />
            </Grid>
        </DataTemplate>

        <DataTemplate x:DataType="vm:SliderRowViewModel">
            <Grid Classes="tracking-row" Classes.indented="{Binding IsIndented}"
                  ColumnDefinitions="*,Auto"
                  IsVisible="{Binding IsVisible}"
                  IsEnabled="{Binding IsEnabled}"
                  ToolTip.Tip="{Binding Tip}">
                <TextBlock Grid.Column="0" Classes="tracking-row-label" Text="{Binding Label}" />
                <StackPanel Grid.Column="1" Classes="tracking-controls">
                    <Slider Classes="tracking-slider"
                            Minimum="{Binding Minimum}"
                            Maximum="{Binding Maximum}"
                            TickFrequency="{Binding Step}"
                            SmallChange="{Binding Step}"
                            LargeChange="{Binding Step}"
                            IsSnapToTickEnabled="True"
                            Value="{Binding Value, Mode=TwoWay}"
                            AutomationProperties.Name="{Binding Label}" />
                    <c:NumberField Classes="tracking-number"
                                   Minimum="{Binding Minimum}"
                                   Maximum="{Binding Maximum}"
                                   Step="{Binding Step}"
                                   Value="{Binding Value, Mode=TwoWay}"
                                   AutomationProperties.Name="{Binding Label}" />
                </StackPanel>
            </Grid>
        </DataTemplate>

        <DataTemplate x:DataType="vm:RangeRowViewModel">
            <Grid Classes="tracking-row"
                  ColumnDefinitions="*,Auto"
                  IsVisible="{Binding IsVisible}"
                  IsEnabled="{Binding IsEnabled}"
                  ToolTip.Tip="{Binding Tip}">
                <TextBlock Grid.Column="0" Classes="tracking-row-label" Text="{Binding Label}" />
                <StackPanel Grid.Column="1" Classes="tracking-controls">
                    <c:NumberField Classes="tracking-number"
                                   Minimum="{Binding Minimum}"
                                   Maximum="{Binding Maximum}"
                                   Step="{Binding Step}"
                                   Value="{Binding Lower, Mode=TwoWay}"
                                   AutomationProperties.Name="{Binding LowerName}" />
                    <c:RangeSlider Classes="tracking-range"
                                   Minimum="{Binding Minimum}"
                                   Maximum="{Binding Maximum}"
                                   Step="{Binding Step}"
                                   Lower="{Binding Lower, Mode=TwoWay}"
                                   Upper="{Binding Upper, Mode=TwoWay}"
                                   LowerName="{Binding LowerName}"
                                   UpperName="{Binding UpperName}" />
                    <c:NumberField Classes="tracking-number"
                                   Minimum="{Binding Minimum}"
                                   Maximum="{Binding Maximum}"
                                   Step="{Binding Step}"
                                   Value="{Binding Upper, Mode=TwoWay}"
                                   AutomationProperties.Name="{Binding UpperName}" />
                    <Button Classes="tracking-icon-button"
                            Command="{Binding ResetCommand}"
                            IsEnabled="{Binding !IsDefault}"
                            ToolTip.Tip="{x:Static s:Resources.TrackingRange_Reset}"
                            AutomationProperties.Name="{Binding ResetName}">
                        <ui:SymbolIcon Symbol="Undo" />
                    </Button>
                </StackPanel>
            </Grid>
        </DataTemplate>

        <DataTemplate x:DataType="vm:ActionRowViewModel">
            <Grid Classes="tracking-row"
                  ColumnDefinitions="*,Auto"
                  IsVisible="{Binding IsVisible}"
                  IsEnabled="{Binding IsEnabled}"
                  ToolTip.Tip="{Binding Tip}">
                <TextBlock Grid.Column="0" Classes="tracking-row-label" Text="{Binding Label}" />
                <Button Grid.Column="1"
                        Classes="tracking-action"
                        Content="{Binding ButtonText}"
                        Command="{Binding Command}"
                        IsVisible="{Binding !NeedsConfirm}"
                        AutomationProperties.Name="{Binding Label}" />
                <Button Grid.Column="1"
                        Classes="tracking-action"
                        Content="{Binding ButtonText}"
                        IsVisible="{Binding NeedsConfirm}"
                        AutomationProperties.Name="{Binding Label}">
                    <Button.Flyout>
                        <Flyout Placement="BottomEdgeAlignedRight">
                            <StackPanel Classes="tracking-confirm">
                                <TextBlock Classes="tracking-confirm-text" Text="{Binding ConfirmText}" />
                                <StackPanel Classes="tracking-confirm-buttons">
                                    <Button Classes="tracking-confirm-cancel"
                                            Content="{x:Static s:Resources.TrackingAction_Cancel}"
                                            Click="OnConfirmCancel" />
                                    <Button Classes="accent tracking-confirm-run"
                                            Content="{Binding ButtonText}"
                                            Click="OnConfirmRun" />
                                </StackPanel>
                            </StackPanel>
                        </Flyout>
                    </Button.Flyout>
                </Button>
            </Grid>
        </DataTemplate>

        <DataTemplate x:DataType="vm:TextRowViewModel">
            <Grid Classes="tracking-row"
                  ColumnDefinitions="*,Auto"
                  IsVisible="{Binding IsVisible}"
                  IsEnabled="{Binding IsEnabled}"
                  ToolTip.Tip="{Binding Tip}">
                <TextBlock Grid.Column="0" Classes="tracking-row-label" Text="{Binding Label}" />
                <TextBox Grid.Column="1"
                         Classes="tracking-text"
                         MaxLength="6"
                         Text="{Binding Text, Mode=TwoWay, UpdateSourceTrigger=LostFocus}"
                         AutomationProperties.Name="{Binding Label}" />
            </Grid>
        </DataTemplate>

        <DataTemplate x:DataType="vm:TrackingCardViewModel">
            <Border Classes="card tracking-card">
                <StackPanel>
                    <Grid Classes="tracking-card-header" ColumnDefinitions="*,Auto,Auto">
                        <StackPanel Grid.Column="0" Classes="tracking-label">
                            <TextBlock Classes="tracking-card-title" Text="{Binding Title}" />
                            <TextBlock Classes="tracking-card-description" Text="{Binding Description}" IsVisible="{Binding HasDescription}" />
                        </StackPanel>
                        <Border Grid.Column="1"
                                Classes="chip"
                                Classes.success="{Binding ChipKind, Converter={x:Static h:ChipKindConverters.IsSuccess}}"
                                Classes.progress="{Binding ChipKind, Converter={x:Static h:ChipKindConverters.IsProgress}}">
                            <TextBlock Classes="chip-text" Text="{Binding ChipText}" />
                        </Border>
                        <ToggleSwitch Grid.Column="2"
                                      Classes="tracking-switch"
                                      IsChecked="{Binding IsOn, Mode=TwoWay}"
                                      AutomationProperties.Name="{Binding SwitchName}" />
                    </Grid>
                    <ProgressBar Classes="tracking-progress"
                                 Minimum="0"
                                 Maximum="1"
                                 Value="{Binding Progress}"
                                 IsVisible="{Binding ShowProgress}" />
                    <ItemsControl Classes="tracking-sections" ItemsSource="{Binding MainSections}" />
                    <ToggleButton Classes="tracking-more"
                                  IsVisible="{Binding HasMore}"
                                  IsChecked="{Binding IsMoreOpen, Mode=TwoWay}"
                                  AutomationProperties.Name="{Binding MoreLabel}">
                        <StackPanel Classes="icon-label">
                            <TextBlock Text="{Binding MoreLabel}" />
                            <ui:SymbolIcon Classes="chevron" Symbol="ChevronDown" IsVisible="{Binding !IsMoreOpen}" />
                            <ui:SymbolIcon Classes="chevron" Symbol="ChevronUp" IsVisible="{Binding IsMoreOpen}" />
                        </StackPanel>
                    </ToggleButton>
                    <ItemsControl Classes="tracking-sections tracking-more-sections" ItemsSource="{Binding MoreSections}" IsVisible="{Binding ShowMore}" />
                </StackPanel>
            </Border>
        </DataTemplate>

        <DataTemplate x:DataType="vm:PreviewChannelViewModel">
            <StackPanel Classes="tracking-channel">
                <TextBlock Classes="tracking-channel-label" Text="{Binding Label}" ToolTip.Tip="{Binding Label}" />
                <c:LevelBar Minimum="{Binding Minimum}" Maximum="{Binding Maximum}" Value="{Binding Raw}" />
                <c:LevelBar Minimum="{Binding Minimum}" Maximum="{Binding Maximum}" Value="{Binding Adjusted}" IsAdjusted="True" />
            </StackPanel>
        </DataTemplate>
    </UserControl.DataTemplates>

    <ScrollViewer>
        <StackPanel Classes="page-stack">
            <TextBlock Classes="page-title" Text="{x:Static s:Resources.Shell_TrackingSettings_Content}" />

            <Border Classes="card tracking-hero">
                <StackPanel>
                    <Grid Classes="tracking-card-header" ColumnDefinitions="*,Auto">
                        <StackPanel Grid.Column="0" Classes="tracking-label">
                            <TextBlock Classes="tracking-card-title" Text="{x:Static s:Resources.TrackingMaster_Title}" />
                            <TextBlock Classes="tracking-card-description" Text="{x:Static s:Resources.TrackingMaster_OnDescription}" IsVisible="{Binding MasterOn}" />
                            <TextBlock Classes="tracking-card-description" Text="{x:Static s:Resources.TrackingMaster_OffDescription}" IsVisible="{Binding !MasterOn}" />
                        </StackPanel>
                        <ToggleSwitch Grid.Column="1"
                                      x:Name="MasterSwitch"
                                      Classes="tracking-switch"
                                      IsChecked="{Binding MasterOn, Mode=TwoWay}"
                                      AutomationProperties.Name="{x:Static s:Resources.TrackingMaster_Title}" />
                    </Grid>
                    <Border Classes="tracking-divider" />
                    <Grid Classes="tracking-live-header" ColumnDefinitions="*,Auto">
                        <StackPanel Grid.Column="0" Classes="tracking-legend" IsVisible="{Binding HasData}">
                            <StackPanel Classes="tracking-legend-item">
                                <Border Classes="swatch raw" />
                                <TextBlock Classes="tracking-legend-text" Text="{x:Static s:Resources.TrackingPreview_Raw}" />
                            </StackPanel>
                            <StackPanel Classes="tracking-legend-item">
                                <Border Classes="swatch adjusted" />
                                <TextBlock Classes="tracking-legend-text" Text="{x:Static s:Resources.TrackingPreview_Adjusted}" />
                            </StackPanel>
                        </StackPanel>
                        <TextBlock Grid.Column="0" Classes="tracking-waiting" Text="{x:Static s:Resources.TrackingPreview_Waiting}" IsVisible="{Binding !HasData}" />
                        <Border Grid.Column="1"
                                Classes="chip"
                                Classes.success="{Binding ActivityKind, Converter={x:Static h:ChipKindConverters.IsSuccess}}">
                            <TextBlock Classes="chip-text" Text="{Binding ActivityText}" />
                        </Border>
                    </Grid>
                    <ItemsControl Classes="tracking-channels" Classes.idle="{Binding !HasData}" Classes.paused="{Binding !MasterOn}" ItemsSource="{Binding Channels}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <UniformGrid Columns="4" RowSpacing="12" ColumnSpacing="24" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                    </ItemsControl>
                </StackPanel>
            </Border>

            <ItemsControl x:Name="CardList" Classes="tracking-cards" ItemsSource="{Binding Cards}" IsEnabled="{Binding MasterOn}" />
        </StackPanel>
    </ScrollViewer>
</UserControl>
