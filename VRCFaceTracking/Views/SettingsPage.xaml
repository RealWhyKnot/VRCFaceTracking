<Page
    x:Class="VRCFaceTracking.Views.SettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:toolkit="using:CommunityToolkit.WinUI.Controls"
    xmlns:models="using:VRCFaceTracking.Models"
    mc:Ignorable="d">
    <Page.Resources>
        <x:Double x:Key="SettingsCardSpacing">3</x:Double>
        <Style
            x:Key="SettingsSectionHeaderTextBlockStyle"
            BasedOn="{StaticResource BodyStrongTextBlockStyle}"
            TargetType="TextBlock">
            <Style.Setters>
                <Setter Property="Margin" Value="1,29,0,5" />
            </Style.Setters>
        </Style>
    </Page.Resources>
    <Grid>
        <ScrollViewer
            Padding="0,0,0,0"
            IsTabStop="False"
            UseSystemFocusVisuals="False"
            VerticalScrollBarVisibility="Auto"
            VerticalScrollMode="Auto">
            <StackPanel
                Spacing="{StaticResource SettingsCardSpacing}">
                <StackPanel.ChildrenTransitions>
                    <EntranceThemeTransition FromVerticalOffset="50" />
                    <RepositionThemeTransition IsStaggeringEnabled="False" />
                </StackPanel.ChildrenTransitions>

                <toolkit:SettingsCard x:Uid="ThemeSettings">
                    <toolkit:SettingsCard.HeaderIcon>
                        <FontIcon Glyph="&#xE790;" />
                    </toolkit:SettingsCard.HeaderIcon>
                    <ComboBox x:Name="themeMode" SelectionChanged="themeMode_SelectionChanged">
                        <ComboBoxItem x:Uid="ThemeLight" Tag="Light" />
                        <ComboBoxItem x:Uid="ThemeDark" Tag="Dark" />
                        <ComboBoxItem x:Uid="ThemeSystem" Tag="Default" />
                    </ComboBox>
                </toolkit:SettingsCard>

                <toolkit:SettingsCard x:Uid="OscSettings">
                    <toolkit:SettingsCard.HeaderIcon>
                        <FontIcon Glyph="&#xEC05;" />
                    </toolkit:SettingsCard.HeaderIcon>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center">
                            <NumberBox
                                x:Uid="OscInPortBox"
                                SpinButtonPlacementMode="Inline"
                                SmallChange="1"
                                LargeChange="10"
                                Margin="15, 0, 15, 0"
                                Minimum="1"
                                Maximum="65535"
                                Value="{x:Bind OscTarget.InPort, Mode=TwoWay}"/>

                            <TextBox
                                     x:Uid="OscAddressBox"
                                     Text="{x:Bind OscTarget.DestinationAddress, Mode=TwoWay}"/>

                            <NumberBox
                                x:Uid="OscOutPortBox"
                                SpinButtonPlacementMode="Inline"
                                SmallChange="1"
                                LargeChange="10"
                                Minimum="1"
                                Maximum="65535"
                                Margin="15, 0, 15, 0"
                                Value="{x:Bind OscTarget.OutPort, Mode=TwoWay}"/>
                        </StackPanel>
                    </Grid>
                </toolkit:SettingsCard>

                <toolkit:SettingsCard x:Uid="AutoStartSettings" IsEnabled="{x:Bind ViewModel.IsOpenVREnabled, Mode=OneWay}">
                    <toolkit:SettingsCard.HeaderIcon>
                        <FontIcon Glyph="&#xE840;" />
                    </toolkit:SettingsCard.HeaderIcon>
                    <ToggleSwitch IsOn="{x:Bind ViewModel.AutoStart, Mode=TwoWay}"/>
                </toolkit:SettingsCard>

                <toolkit:SettingsExpander x:Uid="DiagnosticsSettings">
                    <toolkit:SettingsExpander.HeaderIcon>
                        <FontIcon Glyph="&#xE9D9;" />
                    </toolkit:SettingsExpander.HeaderIcon>
                    <TextBlock Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="{x:Bind ViewModel.VersionText}" />
                    <toolkit:SettingsExpander.Items>
                        <toolkit:SettingsCard x:Uid="VerboseLoggingSettings"
                            IsEnabled="{x:Bind ViewModel.IsVerboseToggleEnabled}"
                            Description="{x:Bind ViewModel.VerboseDescription}">
                            <ToggleSwitch IsOn="{x:Bind ViewModel.VerboseLogging, Mode=TwoWay}" />
                        </toolkit:SettingsCard>
                        <toolkit:SettingsCard x:Uid="LogFilesToKeepSettings">
                            <NumberBox Minimum="1" Maximum="200" SmallChange="1" SpinButtonPlacementMode="Compact" Value="{x:Bind ViewModel.LogFilesToKeep, Mode=TwoWay}" />
                        </toolkit:SettingsCard>
                        <toolkit:SettingsCard x:Uid="LogFolderSettings" Description="{x:Bind ViewModel.LogDirectory}">
                            <Button x:Uid="OpenLogsButton" Command="{x:Bind ViewModel.OpenLogsCommand}" />
                        </toolkit:SettingsCard>
                    </toolkit:SettingsExpander.Items>
                </toolkit:SettingsExpander>

                <toolkit:SettingsExpander x:Uid="RiskySettings">
                    <toolkit:SettingsExpander.HeaderIcon>
                        <FontIcon Glyph="&#xE7BA;" />
                    </toolkit:SettingsExpander.HeaderIcon>
                    <ToggleSwitch x:Name="dangerAcceptToggle" x:Uid="RiskyToggle" Toggled="AcceptToggle_OnToggled" IsOn="{x:Bind RiskySettingsViewModel.Enabled, Mode=OneWay}"/>
                    <toolkit:SettingsExpander.Items>
                        <toolkit:SettingsCard x:Uid="ForceRelevancyToggle"
                            x:Name="allParamsRelevant"
                            IsEnabled="False">
                            <ToggleSwitch x:Name="allParamsRelevantToggle" IsOn="{x:Bind RiskySettingsViewModel.AllRelevantDebug, Mode=TwoWay}" />
                        </toolkit:SettingsCard>
                        <toolkit:SettingsCard x:Uid="ForceReInitButton"
                            x:Name="forceReInit"
                            IsEnabled="False">
                            <Button x:Name="forceReInitButton" Click="forceReInitButton_OnClick" x:Uid="ReInitButton" />
                        </toolkit:SettingsCard>
                        <toolkit:SettingsCard x:Uid="ResetVRCFTButton"
                            x:Name="resetVRCFT"
                            IsEnabled="False">
                            <Button x:Name="resetVRCFTButton" Click="resetVRCFTButton_OnClick" x:Uid="ResetButton" />
                        </toolkit:SettingsCard>
                        <toolkit:SettingsCard x:Uid="ResetAvatarConfButton"
                            x:Name="resetAvatarConfig"
                            IsEnabled="False">
                            <Button x:Name="resetVRCAvatarConf" Click="resetVRCAvatarConf_OnClick" x:Uid="ResetButton" />
                        </toolkit:SettingsCard>
                    </toolkit:SettingsExpander.Items>
                </toolkit:SettingsExpander>

                <!-- Debug Hardware -->
                <toolkit:SettingsCard x:Uid="HardwareDebug" ContentAlignment="Vertical">
                    <toolkit:SettingsCard.HeaderIcon>
                        <FontIcon Glyph="&#xEBE8;"/>
                    </toolkit:SettingsCard.HeaderIcon>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" /> <!-- Separator Column -->
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Image Grid.Column="0" Source="{x:Bind UpperImageSource}" Stretch="Uniform" />
                        <AppBarSeparator x:Name="HardwareDebugSeparator" Grid.Column="1" />
                        <Image Grid.Column="2" Source="{x:Bind LowerImageSource}" Stretch="Uniform" />
                    </Grid>
                </toolkit:SettingsCard>

                <!--  About  -->
                <TextBlock Style="{StaticResource SettingsSectionHeaderTextBlockStyle}" x:Uid="About" />

                <toolkit:SettingsExpander x:Uid="Copyright" Header="VRCFaceTracking">
                    <TextBlock
                            Margin="0,-2,0,0"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            IsTextSelectionEnabled="True"
                            Text="{x:Bind ViewModel.VersionText}" />
                    <toolkit:SettingsExpander.Items>
                        <toolkit:SettingsCard
                            x:Uid="PrivacyPolicyCard"
                            IsClickEnabled="True"
                            Click="privacyPolicyCard_Click">
                            <toolkit:SettingsCard.ActionIcon>
                                <FontIcon Glyph="&#xE8A7;" />
                            </toolkit:SettingsCard.ActionIcon>
                        </toolkit:SettingsCard>
                        <toolkit:SettingsCard x:Uid="CloneRepoCard">
                            <TextBlock
                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                    IsTextSelectionEnabled="True"
                                    Text="git clone https://github.com/RealWhyKnot/VRCFaceTracking" />
                        </toolkit:SettingsCard>
                        <toolkit:SettingsCard
                                x:Uid="BugRequestCard"
                                IsClickEnabled="True"
                                Click="bugRequestCard_Click">
                            <toolkit:SettingsCard.ActionIcon>
                                <FontIcon Glyph="&#xE8A7;" />
                            </toolkit:SettingsCard.ActionIcon>
                        </toolkit:SettingsCard>
                        <toolkit:SettingsCard
                                HorizontalContentAlignment="Left"
                                ContentAlignment="Vertical"
                                x:Uid="Dependencies">
                            <StackPanel Margin="-12,0,0,0" Orientation="Vertical">
                                <HyperlinkButton Content="SimpleRustOSC" NavigateUri="https://github.com/benaclejames/SimpleRustOSC" />
                            </StackPanel>
                        </toolkit:SettingsCard>
                        <toolkit:SettingsCard
                                HorizontalContentAlignment="Left"
                                ContentAlignment="Vertical"
                                x:Uid="Disclaimer">
                        </toolkit:SettingsCard>
                    </toolkit:SettingsExpander.Items>
                </toolkit:SettingsExpander>

                <toolkit:SettingsExpander x:Uid="Credits" Header="Credits">
                    <toolkit:SettingsExpander.Items>
                        <toolkit:SettingsCard HorizontalContentAlignment="Stretch"
                                           ContentAlignment="Vertical"
                                           x:Uid="ContributorsCard">
                                <ItemsControl ItemsSource="{x:Bind ViewModel.Contributors, Mode=OneWay}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate x:DataType="models:GithubContributor">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <!-- Left alligned hyperlink w/ text -->
                                                <HyperlinkButton Grid.Column="0" Margin="-12,0,0,0" Content="{x:Bind login}" NavigateUri="{x:Bind html_url}"/>

                                                <!-- Right alligned text -->
                                                <TextBlock Grid.Column="1" Text="{x:Bind contributions}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextAlignment="Right"/>
                                                <TextBlock Grid.Column="2" x:Uid="ContributionsLabel" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextAlignment="Right"/>
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                        </toolkit:SettingsCard>
                    </toolkit:SettingsExpander.Items>
                </toolkit:SettingsExpander>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Page>
