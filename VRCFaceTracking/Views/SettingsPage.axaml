<UserControl
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ui="using:FluentAvalonia.UI.Controls"
    xmlns:s="using:VRCFaceTracking.Strings"
    xmlns:vm="using:VRCFaceTracking.ViewModels"
    x:DataType="vm:SettingsViewModel"
    x:Class="VRCFaceTracking.Views.SettingsPage">

    <ScrollViewer>
        <StackPanel Classes="page-stack" Spacing="4">

            <TextBlock Text="{x:Static s:Resources.Appearance_Text}" Classes="section-header" />

            <ui:SettingsExpander Header="{x:Static s:Resources.ThemeSettings_Header}"
                                 Description="{x:Static s:Resources.ThemeSettings_Description}">
                <ui:SettingsExpander.Footer>
                    <ComboBox x:Name="ThemeCombo" SelectionChanged="ThemeCombo_SelectionChanged" MinWidth="160">
                        <ComboBoxItem Content="{x:Static s:Resources.Settings_Theme_Light_Content}" Tag="Light" />
                        <ComboBoxItem Content="{x:Static s:Resources.Settings_Theme_Dark_Content}" Tag="Dark" />
                        <ComboBoxItem Content="{x:Static s:Resources.Settings_Theme_Default_Content}" Tag="Default" />
                    </ComboBox>
                </ui:SettingsExpander.Footer>
            </ui:SettingsExpander>

            <TextBlock Text="{x:Static s:Resources.OscSectionHeader}" Classes="section-header" />

            <ui:SettingsExpander
                Header="{x:Static s:Resources.OscSettings_Header}"
                Description="{x:Static s:Resources.OscSettings_Description}">
                <ui:SettingsExpander.Footer>
                    <WrapPanel ItemSpacing="12" LineSpacing="8" MaxWidth="420">
                        <StackPanel Classes="field">
                            <TextBlock Classes="caption" Text="{x:Static s:Resources.OscInPortLabel}" />
                            <NumericUpDown
                                Minimum="1"
                                Maximum="65535"
                                Increment="1"
                                FormatString="0"
                                MinWidth="120"
                                ToolTip.Tip="{x:Static s:Resources.OscInPortTooltip}"
                                Value="{Binding OscTarget.InPort, Mode=TwoWay}" />
                        </StackPanel>
                        <StackPanel Classes="field">
                            <TextBlock Classes="caption" Text="{x:Static s:Resources.OscAddressLabel}" />
                            <TextBox
                                Watermark="127.0.0.1"
                                MinWidth="140"
                                ToolTip.Tip="{x:Static s:Resources.OscAddressTooltip}"
                                Text="{Binding OscTarget.DestinationAddress, Mode=TwoWay}" />
                        </StackPanel>
                        <StackPanel Classes="field">
                            <TextBlock Classes="caption" Text="{x:Static s:Resources.OscOutPortLabel}" />
                            <NumericUpDown
                                Minimum="1"
                                Maximum="65535"
                                Increment="1"
                                FormatString="0"
                                MinWidth="120"
                                ToolTip.Tip="{x:Static s:Resources.OscOutPortTooltip}"
                                Value="{Binding OscTarget.OutPort, Mode=TwoWay}" />
                        </StackPanel>
                    </WrapPanel>
                </ui:SettingsExpander.Footer>
            </ui:SettingsExpander>

            <TextBlock Text="{x:Static s:Resources.OpenVrSectionHeader}" Classes="section-header" />

            <ui:SettingsExpander
                Header="{x:Static s:Resources.AutoStartSettings_Header}"
                Description="{Binding AutoStartDescription}"
                IsVisible="{Binding IsOpenVRSupported}"
                ToolTip.Tip="{x:Static s:Resources.AutoStartSettingsTooltip}">
                <ui:SettingsExpander.Footer>
                    <ToggleSwitch
                        IsChecked="{Binding AutoStart, Mode=TwoWay}"
                        IsEnabled="{Binding IsOpenVREnabled}" />
                </ui:SettingsExpander.Footer>
            </ui:SettingsExpander>

            <ui:SettingsExpander
                Header="{x:Static s:Resources.ExitWithSteamVrHeader}"
                Description="{x:Static s:Resources.ExitWithSteamVrDescription}"
                IsVisible="{Binding IsOpenVRSupported}">
                <ui:SettingsExpander.Footer>
                    <ToggleSwitch
                        IsChecked="{Binding ExitWithSteamVr, Mode=TwoWay}" />
                </ui:SettingsExpander.Footer>
            </ui:SettingsExpander>

            <TextBlock Text="{x:Static s:Resources.DeveloperSectionHeader}" Classes="section-header" />

            <ui:SettingsExpander
                Header="{x:Static s:Resources.DeveloperModeHeader}"
                Description="{x:Static s:Resources.DeveloperModeDescription}">
                <ui:SettingsExpander.Footer>
                    <ToggleSwitch
                        IsChecked="{Binding Developer.Enabled, Mode=TwoWay}" />
                </ui:SettingsExpander.Footer>
            </ui:SettingsExpander>

            <StackPanel Spacing="4" IsVisible="{Binding Developer.Enabled}">

                <TextBlock Text="{x:Static s:Resources.LoggingSectionHeader}" Classes="section-header" />

                <ui:SettingsExpander
                    Header="{x:Static s:Resources.VerboseLoggingHeader}"
                    Description="{Binding VerboseDescription}"
                    ToolTip.Tip="{x:Static s:Resources.VerboseLoggingTooltip}">
                    <ui:SettingsExpander.Footer>
                        <ToggleSwitch
                            IsChecked="{Binding VerboseLogging, Mode=TwoWay}"
                            IsEnabled="{Binding IsVerboseToggleEnabled}" />
                    </ui:SettingsExpander.Footer>
                </ui:SettingsExpander>

                <ui:SettingsExpander
                    Header="{x:Static s:Resources.LogFilesToKeepHeader}"
                    Description="{x:Static s:Resources.LogFilesToKeepDescription}">
                    <ui:SettingsExpander.Footer>
                        <NumericUpDown
                            Minimum="1"
                            Maximum="200"
                            Increment="1"
                            FormatString="0"
                            MinWidth="120"
                            ToolTip.Tip="{x:Static s:Resources.LogFilesToKeepTooltip}"
                            Value="{Binding LogFilesToKeep, Mode=TwoWay}" />
                    </ui:SettingsExpander.Footer>
                </ui:SettingsExpander>

                <ui:SettingsExpander
                    Header="{x:Static s:Resources.LogFolderHeader}"
                    Description="{Binding LogFolderDescription}">
                    <ui:SettingsExpander.Footer>
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <Button Content="{x:Static s:Resources.LogFolderChangeContent}"
                                    Click="ChangeLogFolder_Click"
                                    ToolTip.Tip="{x:Static s:Resources.LogFolderTooltip}" />
                            <Button Content="{x:Static s:Resources.LogFolderResetContent}"
                                    Command="{Binding ResetLogDirectoryCommand}"
                                    IsEnabled="{Binding HasCustomLogFolder}" />
                            <Button Content="{x:Static s:Resources.OpenLogsButtonContent}"
                                    Command="{Binding OpenLogsCommand}" />
                        </StackPanel>
                    </ui:SettingsExpander.Footer>
                </ui:SettingsExpander>

                <Expander x:Name="CameraStreamsExpander" Header="{x:Static s:Resources.CameraStreamsHeader}"
                          HorizontalAlignment="Stretch">
                    <Grid ColumnDefinitions="*,*">
                        <StackPanel Grid.Column="0" Spacing="4">
                            <TextBlock Text="{x:Static s:Resources.CameraStreamsEye}" />
                            <Image x:Name="EyeStreamImage" Stretch="Uniform" MaxHeight="240" />
                            <TextBlock x:Name="EyeStreamStatus" Classes="caption"
                                       Text="{x:Static s:Resources.CameraStreamsWaiting}" />
                        </StackPanel>
                        <StackPanel Grid.Column="1" Spacing="4">
                            <TextBlock Text="{x:Static s:Resources.CameraStreamsLip}" />
                            <Image x:Name="LipStreamImage" Stretch="Uniform" MaxHeight="240" />
                            <TextBlock x:Name="LipStreamStatus" Classes="caption"
                                       Text="{x:Static s:Resources.CameraStreamsWaiting}" />
                        </StackPanel>
                    </Grid>
                </Expander>

            </StackPanel>

            <TextBlock Text="{x:Static s:Resources.UpdatesSectionHeader}" Classes="section-header"
                       IsVisible="{Binding IsUpdateCheckAvailable}" />

            <ui:SettingsExpander
                Header="{x:Static s:Resources.UpdatesHeader}"
                Description="{x:Static s:Resources.UpdatesDescription}"
                IsVisible="{Binding IsUpdateCheckAvailable}">
                <ui:SettingsExpander.Footer>
                    <ToggleSwitch
                        IsChecked="{Binding CheckUpdatesOnStartup, Mode=TwoWay}" />
                </ui:SettingsExpander.Footer>

                <ui:SettingsExpander.Items>
                    <ui:SettingsExpanderItem
                        Content="{x:Static s:Resources.CheckUpdatesHeader}"
                        Description="{x:Static s:Resources.CheckUpdatesDescription}">
                        <ui:SettingsExpanderItem.Footer>
                            <Button Content="{x:Static s:Resources.CheckUpdatesButtonContent}"
                                    Command="{Binding CheckUpdatesCommand}"
                                    ToolTip.Tip="{x:Static s:Resources.CheckUpdatesTooltip}" />
                        </ui:SettingsExpanderItem.Footer>
                    </ui:SettingsExpanderItem>
                </ui:SettingsExpander.Items>
            </ui:SettingsExpander>

            <StackPanel Spacing="4" IsVisible="{Binding Developer.Enabled}">

                <TextBlock Text="{x:Static s:Resources.AdvancedSectionHeader}" Classes="section-header" />

                <ui:SettingsExpander
                    Header="{x:Static s:Resources.RiskySettings_Header}"
                    Description="{x:Static s:Resources.RiskySettings_Description}">
                    <ui:SettingsExpander.Footer>
                        <ToggleSwitch
                            IsChecked="{Binding RiskySettings.Enabled, Mode=TwoWay}"
                            OffContent="{x:Static s:Resources.GremlinModeToggleContent}"
                            OnContent="{x:Static s:Resources.GremlinModeToggleContent}"
                            ToolTip.Tip="{x:Static s:Resources.GremlinModeTooltip}" />
                    </ui:SettingsExpander.Footer>

                    <ui:SettingsExpander.Items>
                        <ui:SettingsExpanderItem
                            Content="{x:Static s:Resources.ForceRelevancyToggle_Header}"
                            Description="{x:Static s:Resources.ForceRelevancyToggle_Description}"
                            IsEnabled="{Binding RiskySettings.Enabled}">
                            <ui:SettingsExpanderItem.Footer>
                                <ToggleSwitch
                                    IsChecked="{Binding RiskySettings.AllRelevantDebug, Mode=TwoWay}"
                                    ToolTip.Tip="{x:Static s:Resources.ForceRelevancyTooltip}" />
                            </ui:SettingsExpanderItem.Footer>
                        </ui:SettingsExpanderItem>

                        <ui:SettingsExpanderItem
                            Content="{x:Static s:Resources.ForceReInitButton_Header}"
                            Description="{x:Static s:Resources.ForceReInitButton_Description}"
                            IsEnabled="{Binding RiskySettings.Enabled}">
                            <ui:SettingsExpanderItem.Footer>
                                <Button Content="{x:Static s:Resources.ReInitButton_Content}" Click="ForceReInit_Click" />
                            </ui:SettingsExpanderItem.Footer>
                        </ui:SettingsExpanderItem>

                        <ui:SettingsExpanderItem
                            Content="{x:Static s:Resources.ResetVRCFTButton_Header}"
                            Description="{x:Static s:Resources.ResetVRCFTButton_Description}"
                            IsEnabled="{Binding RiskySettings.Enabled}">
                            <ui:SettingsExpanderItem.Footer>
                                <Button Content="{x:Static s:Resources.ResetButton_Content}" Click="ResetVRCFT_Click" />
                            </ui:SettingsExpanderItem.Footer>
                        </ui:SettingsExpanderItem>

                        <ui:SettingsExpanderItem
                            Content="{x:Static s:Resources.ResetAvatarConfButton_Header}"
                            Description="{x:Static s:Resources.ResetAvatarConfButton_Description}"
                            IsEnabled="{Binding RiskySettings.Enabled}">
                            <ui:SettingsExpanderItem.Footer>
                                <Button Content="{x:Static s:Resources.ResetButton_Content}" Click="ResetAvatarConfig_Click" />
                            </ui:SettingsExpanderItem.Footer>
                        </ui:SettingsExpanderItem>
                    </ui:SettingsExpander.Items>
                </ui:SettingsExpander>

            </StackPanel>

            <TextBlock Text="{x:Static s:Resources.About_Text}" Classes="section-header" />

            <ui:SettingsExpander Header="{x:Static s:Resources.AppDisplayName}">
                <ui:SettingsExpander.Footer>
                    <TextBlock Classes="caption" Text="{x:Static vm:SettingsViewModel.VersionText}" VerticalAlignment="Center" />
                </ui:SettingsExpander.Footer>

                <ui:SettingsExpander.Items>
                    <ui:SettingsExpanderItem Content="{x:Static s:Resources.ContributorsHeader}" Description="{x:Static s:Resources.Credits_Description}">
                        <ui:SettingsExpanderItem.Footer>
                            <ScrollViewer MaxHeight="300" VerticalScrollBarVisibility="Auto">
                                <ItemsControl ItemsSource="{Binding Contributors}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Button
                                                HorizontalAlignment="Stretch"
                                                HorizontalContentAlignment="Left"
                                                Margin="0,2"
                                                Padding="10,6"
                                                Tag="{Binding html_url}"
                                                Click="ContributorButton_Click">
                                                <StackPanel Orientation="Horizontal" Spacing="10">
                                                    <TextBlock Text="{Binding login}" FontSize="13" />
                                                    <TextBlock
                                                        Text="{Binding contributions, StringFormat='{}{0} commits'}"
                                                        FontSize="12"
                                                        Opacity="0.55"
                                                        VerticalAlignment="Center" />
                                                </StackPanel>
                                            </Button>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>
                        </ui:SettingsExpanderItem.Footer>
                    </ui:SettingsExpanderItem>
                </ui:SettingsExpander.Items>
            </ui:SettingsExpander>

        </StackPanel>
    </ScrollViewer>
</UserControl>
