<UserControl
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ui="using:FluentAvalonia.UI.Controls"
    xmlns:s="using:VRCFaceTracking.Strings"
    xmlns:vm="using:VRCFaceTracking.ViewModels"
    xmlns:mutation="clr-namespace:VRCFaceTracking.Core.Params.Data.Mutation;assembly=VRCFaceTracking.Core"
    x:DataType="vm:MutatorViewModel"
    x:Class="VRCFaceTracking.Views.MutatorPage">
    <Grid RowDefinitions="*,Auto">
        <ScrollViewer Grid.Row="0">
        <ItemsControl ItemsSource="{Binding Mutations}" Margin="0,4">
            <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="{x:Type mutation:TrackingMutation}">
                    <Expander Margin="0,0,0,6" HorizontalAlignment="Stretch">
                        <Expander.Header>
                            <Grid ColumnDefinitions="Auto,*" Margin="0,4">
                                <ToggleSwitch
                                    Grid.Column="0"
                                    IsChecked="{Binding IsActive, Mode=TwoWay}"
                                    OffContent="{x:Static s:Resources.MutationToggleOff}"
                                    OnContent="{x:Static s:Resources.MutationToggleOn}"
                                    ToolTip.Tip="{x:Static s:Resources.MutationActiveToggleTooltip}"
                                    Margin="0,0,12,0"
                                    MinWidth="86"
                                    VerticalAlignment="Center" />
                                <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                                    <TextBlock Classes="title" Text="{Binding Name}" />
                                    <TextBlock Classes="caption" Text="{Binding Description}" TextWrapping="Wrap" />
                                </StackPanel>
                            </Grid>
                        </Expander.Header>

                        <Border Padding="4,0">
                            <ItemsControl ItemsSource="{Binding Components}">
                                <ItemsControl.DataTemplates>
                                    <DataTemplate x:DataType="{x:Type mutation:MutationProperty}">
                                        <Border Classes="mutation-row">
                                            <Border.IsVisible>
                                                <MultiBinding Converter="{x:Static BoolConverters.Or}">
                                                    <Binding Path="!IsDeveloper" />
                                                    <Binding Path="$parent[UserControl].((vm:MutatorViewModel)DataContext).Developer.Enabled" />
                                                </MultiBinding>
                                            </Border.IsVisible>
                                            <Grid ColumnDefinitions="5*,6*">
                                                <TextBlock Grid.Column="0" Text="{Binding Name}" VerticalAlignment="Center" TextWrapping="Wrap" />
                                                <CheckBox
                                                    Grid.Column="1"
                                                    IsChecked="{Binding BoolValue, Mode=TwoWay}"
                                                    IsVisible="{Binding Type, Converter={StaticResource MutationTypeCheckboxConverter}}"
                                                    HorizontalAlignment="Right" />
                                                <Grid
                                                    Grid.Column="1"
                                                    ColumnDefinitions="Auto,*"
                                                    IsVisible="{Binding Type, Converter={StaticResource MutationTypeSliderConverter}}"
                                                    ColumnSpacing="8">
                                                    <TextBlock Grid.Column="0"
                                                        Text="{Binding FloatValue, StringFormat='{}{0:F2}'}"
                                                        VerticalAlignment="Center"
                                                        MinWidth="45"
                                                        TextAlignment="Right" />
                                                    <Slider
                                                        Minimum="{Binding Min}"
                                                        Maximum="{Binding Max}"
                                                        Value="{Binding FloatValue, Mode=TwoWay}"
                                                        TickFrequency="0.01"
                                                        Grid.Column="1"
                                                        HorizontalAlignment="Stretch"
                                                        MinWidth="120" />
                                                </Grid>
                                                <TextBox
                                                    Grid.Column="1"
                                                    Text="{Binding StringValue, Mode=TwoWay}"
                                                    IsVisible="{Binding Type, Converter={StaticResource MutationTypeTextConverter}}"
                                                    HorizontalAlignment="Stretch" />
                                            </Grid>
                                        </Border>
                                    </DataTemplate>

                                    <DataTemplate x:DataType="{x:Type mutation:MutationRangeProperty}">
                                        <Border Classes="mutation-row">
                                            <Grid ColumnDefinitions="5*,6*">
                                                <TextBlock Grid.Column="0" Text="{Binding Name}" VerticalAlignment="Center" TextWrapping="Wrap" />
                                                <Grid Grid.Column="1" ColumnDefinitions="Auto,*,*,Auto" ColumnSpacing="8" VerticalAlignment="Center">
                                                    <TextBlock Grid.Column="0" Text="{Binding Item1, StringFormat='{}{0:F2}'}" VerticalAlignment="Center" MinWidth="40" TextAlignment="Right" />
                                                    <Slider Grid.Column="1" Minimum="{Binding Min}" Maximum="{Binding Max}" Value="{Binding Item1, Mode=TwoWay}" TickFrequency="0.01" MinWidth="70" />
                                                    <Slider Grid.Column="2" Minimum="{Binding Min}" Maximum="{Binding Max}" Value="{Binding Item2, Mode=TwoWay}" TickFrequency="0.01" MinWidth="70" />
                                                    <TextBlock Grid.Column="3" Text="{Binding Item2, StringFormat='{}{0:F2}'}" VerticalAlignment="Center" MinWidth="40" />
                                                </Grid>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>

                                    <DataTemplate x:DataType="{x:Type mutation:MutationAction}">
                                        <Border Classes="mutation-row">
                                            <Border.IsVisible>
                                                <MultiBinding Converter="{x:Static BoolConverters.Or}">
                                                    <Binding Path="!IsDeveloper" />
                                                    <Binding Path="$parent[UserControl].((vm:MutatorViewModel)DataContext).Developer.Enabled" />
                                                </MultiBinding>
                                            </Border.IsVisible>
                                            <Grid ColumnDefinitions="5*,6*">
                                                <Button Grid.Column="1" Content="{Binding Name}" Command="{Binding}" HorizontalAlignment="Right" />
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.DataTemplates>
                            </ItemsControl>
                        </Border>
                    </Expander>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>
        </ScrollViewer>

        <CheckBox
            Grid.Row="1"
            Content="{x:Static s:Resources.ShowDeveloperSettingsContent}"
            IsChecked="{Binding Developer.Enabled, Mode=TwoWay}"
            Margin="0,8,0,0" />
    </Grid>
</UserControl>
