<Styles
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ui="using:FluentAvalonia.UI.Controls">

    <Styles.Resources>
        <x:Double x:Key="PageMaxWidth">1100</x:Double>
        <CrossFade x:Key="PageFade" Duration="0:0:0.15" />
        <CornerRadius x:Key="RadiusMd">6</CornerRadius>
        <CornerRadius x:Key="RadiusSm">4</CornerRadius>
        <Thickness x:Key="CardPadding">16,14</Thickness>
        <Thickness x:Key="RowPadding">16,10</Thickness>
    </Styles.Resources>

    <Style Selector="TextBlock.section-header">
        <Setter Property="FontSize" Value="12" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Opacity" Value="0.6" />
        <Setter Property="Margin" Value="0,16,0,6" />
    </Style>

    <Style Selector="TextBlock.title">
        <Setter Property="FontSize" Value="14" />
        <Setter Property="FontWeight" Value="SemiBold" />
    </Style>

    <Style Selector="TextBlock.caption">
        <Setter Property="FontSize" Value="12" />
        <Setter Property="Opacity" Value="0.6" />
    </Style>

    <Style Selector="TextBlock.value">
        <Setter Property="FontSize" Value="12" />
    </Style>

    <Style Selector="TextBlock.detail-label">
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Opacity" Value="0.7" />
    </Style>

    <Style Selector="Border.card">
        <Setter Property="CornerRadius" Value="{StaticResource RadiusMd}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="BorderBrush" Value="{DynamicResource ControlStrokeColorDefaultBrush}" />
        <Setter Property="Background" Value="{DynamicResource ControlFillColorDefaultBrush}" />
        <Setter Property="Padding" Value="{StaticResource CardPadding}" />
    </Style>

    <Style Selector="Border.mutation-row">
        <Setter Property="Padding" Value="{StaticResource RowPadding}" />
        <Setter Property="Margin" Value="0,1" />
    </Style>

    <Style Selector="Border.state-badge">
        <Setter Property="CornerRadius" Value="{StaticResource RadiusSm}" />
        <Setter Property="Padding" Value="6,2" />
        <Setter Property="Margin" Value="8,0,0,0" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <Style Selector="StackPanel.page-stack">
        <Setter Property="Spacing" Value="12" />
        <Setter Property="MaxWidth" Value="{StaticResource PageMaxWidth}" />
    </Style>

    <Style Selector="StackPanel.metric">
        <Setter Property="Orientation" Value="Horizontal" />
        <Setter Property="HorizontalAlignment" Value="Right" />
        <Setter Property="Spacing" Value="6" />
    </Style>

    <Style Selector="StackPanel.field">
        <Setter Property="Spacing" Value="4" />
    </Style>

    <Style Selector="StackPanel.icon-label">
        <Setter Property="Orientation" Value="Horizontal" />
        <Setter Property="Spacing" Value="6" />
    </Style>

    <Style Selector="StackPanel.icon-label &gt; ui|SymbolIcon">
        <Setter Property="FontSize" Value="16" />
    </Style>

    <Style Selector="StackPanel.icon-label &gt; TextBlock">
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <Style Selector="ToggleSwitch">
        <Setter Property="OnContent" Value="" />
        <Setter Property="OffContent" Value="" />
    </Style>
</Styles>
